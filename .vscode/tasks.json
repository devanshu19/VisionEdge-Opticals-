{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Flask Backend",
            "type": "shell",
            "command": "${workspaceFolder}/backend/venv/Scripts/python.exe app.py",
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Start Frontend Server",
            "type": "shell",
            "command": "${workspaceFolder}/backend/venv/Scripts/python.exe server.py",
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            },
            "isBackground": true,
            "problemMatcher": []
        }
    ]
}
