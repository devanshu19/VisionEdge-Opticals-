# ============================================================
# VisionEdge — Environment Configuration Template (.env.example)
# ============================================================

# Secret key for Flask session signing (replace in production)
SECRET_KEY=your-secure-flask-secret-key-change-in-production
JWT_SECRET_KEY=your-secure-jwt-signature-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES=86400

# ============================================================
# PRIMARY DATABASE — Supabase PostgreSQL
# ============================================================
# Format for Supabase Supavisor (transaction pooler, port 6543 - recommended):
#   postgresql+psycopg2://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres
#
# Format for direct connection (port 5432):
#   postgresql+psycopg2://postgres:[db-password]@db.[project-ref].supabase.co:5432/postgres
DATABASE_URL=postgresql+psycopg2://postgres.yourprojectref:yourpassword@aws-0-region.pooler.supabase.com:6543/postgres

# Optional convenience alias
SUPABASE_DB_URL=

# SSL mode for PostgreSQL connection: require | prefer | disable
DB_SSLMODE=require

# ============================================================
# Supabase Project APIs (for Storage / Auth / Client SDK)
# ============================================================
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Server-side only: never expose secret service-role key to frontend
# SUPABASE_SECRET_KEY=your-supabase-service-role-key

# ============================================================
# SQLite fallback (OFFLINE LOCAL TESTS ONLY)
# Set to true only when testing offline without network access.
# NEVER use in production; production requires Supabase PostgreSQL.
# ============================================================
USE_SQLITE=false

# ============================================================
# Email / SMTP Configuration (for OTP and Notifications)
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-email@example.com
SMTP_PASSWORD=your-app-specific-password

# ============================================================
# PayU Payment Gateway (India)
# ============================================================
PAYU_KEY=gtKFFx
PAYU_SALT=eCwWELxi
PAYU_URL=https://test.payu.in/_payment

# ============================================================
# Frontend URL (for CORS and payment redirects)
# ============================================================
FRONTEND_URL=http://localhost:8000
