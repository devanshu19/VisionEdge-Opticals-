SECRET_KEY=visionedge_secret_key

# ============================================================
# PRIMARY DATABASE — Supabase PostgreSQL
# ============================================================
# Set this to your Supabase connection string.
# Format for Supabase Supavisor (transaction pooler, port 6543):
#   postgresql+psycopg2://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
#
# Format for direct connection (port 5432):
#   postgresql+psycopg2://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
#
# Leave blank to fall through to USE_SQLITE below.
DATABASE_URL=

# Optional alias (used if DATABASE_URL is empty)
SUPABASE_DB_URL=

# SSL mode for the PostgreSQL connection: prefer | require | disable
DB_SSLMODE=require

# ============================================================
# Supabase Project (only needed for Storage / other Supabase APIs)
# ============================================================
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY — keep this server-side only, never commit it

# ============================================================
# SQLite fallback (OFFLINE LOCAL TESTS ONLY)
# Set to true only when no DATABASE_URL is provided and you
# want to run offline tests against a local SQLite file.
# NEVER use in production; production requires Supabase PostgreSQL.
# ============================================================
USE_SQLITE=true

# ============================================================
# Email / SMTP / PHP Mailer Credentials (for Email OTP)
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=chaudharidevanshu1912@gmail.com
# For Gmail, generate a 16-character Google App Password (My Account > Security > 2-Step > App Passwords)
SMTP_PASSWORD=

# ============================================================
# PayU Payment Gateway (India)
