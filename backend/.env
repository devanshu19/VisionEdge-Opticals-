# Live credentials — uncomment and fill when going live
# PAYU_KEY=your_live_merchant_key
# PAYU_SALT=your_live_salt
# PAYU_URL=https://secure.payu.in/_payment

# Frontend URL (used for success/failure redirect after PayU callback)
FRONTEND_URL=http://localhost:8000